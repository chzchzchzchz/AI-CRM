{
  "name": "target-account-dashboard",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "doctor": "tsx server/doctor.ts",
    "inventory": "tsx server/inventory.ts",
    "case-study": "node scripts/build-case-study.mjs",
    "mcp": "tsx server/mcp-server.ts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --splitting",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check:server": "tsc --noEmit",
    "check:client": "tsc -p tsconfig.client.json --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "audit": "pnpm audit --prod --audit-level moderate",
    "db:push": "drizzle-kit push",
    "gate": "node scripts/quality-gate.mjs",
    "flows": "node scripts/flow-gate.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "verify": "pnpm check && pnpm lint && pnpm test && pnpm inventory && pnpm check:claims && pnpm build && pnpm gate && pnpm flows && pnpm smoke",
    "lint": "eslint client/src",
    "smoke": "node --experimental-strip-types scripts/connector-smoke.mjs"
  },

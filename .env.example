# ============================================
# AI-CRM Environment Configuration
# Copy to .env and fill in your API keys
# ============================================

# Database
DATABASE_URL=mysql://root@localhost:3306/ai_crm

# App
PORT=3333
VITE_APP_ID=ai-crm-demo
JWT_SECRET=your-super-secret-jwt-key-change-this
DEMO_MODE=true

# ============================================
# DATA SOURCE API KEYS
# Add keys for each platform you want to import from
# The CRM will auto-detect which sources are configured
# ============================================

# Salesforce (accounts + contacts)
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret
SALESFORCE_REDIRECT_URI=http://localhost:3333/api/auth/salesforce/callback

# 6sense (intent data, buying stage, account scoring)
SIXSENSE_API_KEY=your_6sense_api_key

# Gong (call recordings, transcripts, sentiment)
GONG_API_KEY=your_gong_api_key

# Clay (enrichment, data imports)
CLAY_API_KEY=your_clay_api_key
CLAY_WEBHOOK_SECRET=your_clay_webhook_secret

# ZoomInfo (contact/company data)
ZOOMINFO_API_KEY=your_zoominfo_api_key

# Apollo (contact data)
APOLLO_API_KEY=your_apollo_api_key

# HubSpot (CRM data)
HUBSPOT_API_KEY=your_hubspot_api_key

# ============================================
# AI & SERVICES
# ============================================

# OpenAI (email generation, account summaries, chat)
OPENAI_API_KEY=your_openai_api_key

# Gemini (alternative AI model)
GEMINI_API_KEY=your_gemini_api_key

# Dust (AI workflows)
DUST_API_KEY=your_dust_api_key

# SendGrid (email delivery)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# HOW TO USE
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in the API keys for platforms you use
# 3. Start the app: npm run dev
# 4. Go to the web UI:
#    - /accounts → "Import from Salesforce" / "Import from Clay" / "Import CSV"
#    - /insights → 6sense tab / Gong tab
#
# All data flows into the SAME accounts + contacts tables.
# Each record stores cross-platform IDs (sfdcAccountId, clayRecordId, etc.)
# This enables unified tracking across all your data sources.

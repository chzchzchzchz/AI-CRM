# ============================================
# TargetDash — Environment Configuration
# Copy to .env (cp .env.example .env). Everything except the demo essentials is
# OPTIONAL — the app runs zero-config in demo mode with free local AI.
# ============================================

# --- Core (demo runs with just these) ---
DEMO_MODE=true
PORT=3333
# Signs session cookies. The value below is a PLACEHOLDER, not a secret — it is
# printed in a public repository, so anything signed with it can be forged by
# anyone who has read this file. Generate your own before deploying:
#
#   openssl rand -base64 48
#
# The server rejects placeholders (any value under 16 chars, or containing
# "replace-me", "dev-only", "changeme", "example" and similar) and refuses to
# start in production with one. In demo and dev it generates a real secret into
# .dev-session-secret instead, so sessions survive a restart.
#
# That guard used to compare against one exact string that appears nowhere in
# this repo, so the placeholder below sailed through it.
JWT_SECRET=dev-only-insecure-secret-replace-me-with-openssl-rand-base64-48

# Real database (set DEMO_MODE=false to use it; demo mode needs none)
DATABASE_URL=mysql://root@localhost:3306/ai_crm
# DATABASE_URL_DEMO=                              # optional separate DB when DEMO_MODE=true

# ============================================
# AI / LLM  (all optional — resolves in this order)
# 1) Forge cloud gateway if set  2) else local Ollama  3) else OpenAI key
# The AI features work FOR FREE via local Ollama with no key (see SETUP.md).
# ============================================
# OpenRouter — fastest way to get hosted AI (many models incl. free ones). Highest priority.
# Get your own key at https://openrouter.ai/keys. Free models are rate-limited upstream and
# rotate, so OPENROUTER_MODEL accepts a comma-separated fallback list (tried in order, falls
# through on 429/unavailable). For reliable speed, use your own key + a cheap paid model.
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Free-tier default (no credits needed, but rate-limited):
# OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free,google/gemma-4-26b-a4b-it:free,meta-llama/llama-3.3-70b-instruct:free
LOCAL_LLM_URL=http://localhost:11434/v1          # local Ollama (OpenAI-compatible)
LOCAL_LLM_MODEL=phi3:mini                         # e.g. phi3:mini, qwen3:8b
# OPENAI_API_KEY=                                 # optional hosted model
# BUILT_IN_FORGE_API_URL=                         # optional Forge LLM gateway
# BUILT_IN_FORGE_API_KEY=
# LLM_REQUEST_TIMEOUT_MS=45000                    # per-request LLM timeout (ms)
# LLM_TOTAL_DEADLINE_MS=60000                     # hard ceiling across the whole provider fallback chain (ms)
# DEMO_DB_PATH=                                   # advanced/test: override the demo JSON DB path (default: demo-db.json)

# ============================================
# BRANDING / WHITE-LABEL (optional — sensible demo defaults)
# Server side reads config/company-config.json first, then these env vars, then defaults.
# ============================================
PRODUCT_NAME=TargetDash
SUPPORT_CONTACT=your admin
COMPANY_EMAIL_DOMAIN=demo.example.com
# Company context for the AI personas (or set in config/company-config.json)
COMPANY_NAME=Demo Company
COMPANY_INDUSTRY=B2B SaaS
COMPANY_DESCRIPTION=AI-Native Sales Intelligence Platform
COMPANY_PRODUCT=Next-generation CRM with AI-powered insights
COMPANY_TARGET=Enterprise 1000+ employees
COMPANY_COMPETITORS=Salesforce, HubSpot, Traditional CRMs
COMPANY_DIFFERENTIATORS=AI-first architecture,Zero manual entry,Real-time signals

# Client-side branding (Vite — must be prefixed VITE_, injected at build time)
VITE_APP_TITLE=TargetDash
VITE_SUPPORT_CONTACT=your admin
# VITE_APP_LOGO=/logo.svg

# ============================================
# INTEGRATIONS (all optional & independent — see ADMIN_SETUP.md)
# ============================================

# Salesforce (accounts + contacts sync — OAuth client-credentials flow)
SALESFORCE_CLIENT_ID=your_salesforce_client_id
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret
SALESFORCE_INSTANCE_URL=https://login.salesforce.com   # or https://yourorg.my.salesforce.com

# 6sense (intent data, buying stage, account scoring)
SIXSENSE_API_KEY=your_6sense_api_key

# Clay (enrichment via inbound webhook — Clay POSTs to /api/trpc/clay.receiveAccount)
CLAY_WEBHOOK_SECRET=your_clay_webhook_secret        # verifies inbound Clay payloads
# CLAY_WEBHOOK_URL=                                  # optional outbound push to a Clay table
# CLAY_API_KEY=

# Gong (call intelligence — calls stored in DB today; live API pull is roadmap)
# GONG_API_KEY=

# SAM.gov (government RFP scraping) + Zapier (automation webhook)
# SAM_GOV_API_KEY=
# RFP_KEYWORDS=software,SaaS,platform   # comma-separated RFP search terms for your product
# ZAPIER_WEBHOOK_SECRET=        # verifies inbound zapier.webhook events (required in prod if used)

# Dust (optional HubSpot-backed intelligence)
# DUST_API_KEY=
# DUST_WORKSPACE_ID=

# --- Native SaaS connectors (see INTEGRATIONS.md) — all optional ---
# Slack / Discord / Teams notifications (paste an Incoming Webhook URL; no OAuth)
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# HubSpot contact sync (private-app token)
# HUBSPOT_ACCESS_TOKEN=
# Notion export (integration token + target database id)
# NOTION_TOKEN=
# NOTION_DATABASE_ID=
# Linear task creation (API key + team id)
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=
# Intercom contact sync (access token)
# INTERCOM_ACCESS_TOKEN=
# Google Chat notifications (space webhook)
# GOOGLE_CHAT_WEBHOOK_URL=
# Twilio SMS (account sid + auth token + from number)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Segment analytics event tracking (write key)
# SEGMENT_WRITE_KEY=
# Auto-notify when an account crosses this intent score (fans out to all chat tools). Default 80.
# HOT_LEAD_THRESHOLD=80
# Sales engagement + scheduling + PM + alerting connectors (see INTEGRATIONS.md)
# SALESLOFT_API_KEY=
# OUTREACH_ACCESS_TOKEN=
# CALENDLY_API_KEY=
# ASANA_ACCESS_TOKEN=
# ASANA_WORKSPACE_ID=
# CLICKUP_API_TOKEN=
# CLICKUP_LIST_ID=
# PAGERDUTY_ROUTING_KEY=
# Airtable record create (personal access token + base + table)
# AIRTABLE_TOKEN=
# AIRTABLE_BASE_ID=
# AIRTABLE_TABLE=
# Pipedrive deal create (API token + your-company subdomain)
# PIPEDRIVE_API_TOKEN=
# PIPEDRIVE_DOMAIN=
# Apollo.io person enrichment (API key)
# ZoomInfo (Enterprise API). Either a password or a PKI key pair; the connector
# handles the JWT lifecycle (tokens expire hourly) so you only set credentials.
# ZOOMINFO_USERNAME=
# ZOOMINFO_PASSWORD=
# ZOOMINFO_CLIENT_ID=
# ZOOMINFO_PRIVATE_KEY=

# APOLLO_API_KEY=

# ============================================
# EMAIL (transactional — verification, password reset, access approval)
# ============================================
# SENDGRID_API_KEY=your_sendgrid_api_key
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ============================================
# AUTH / MISC (optional)
# ============================================
# OAUTH_SERVER_URL=                                 # external OAuth portal (demo bypasses auth)
# ALLOWED_ORIGINS=http://localhost:3333             # CORS allowlist (comma-separated)
# Client analytics (self-hosted Umami — omit to disable)
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=

# ============================================
# HOW TO USE
# ============================================
# 1. cp .env.example .env
# 2. Demo works as-is. For real data, set DEMO_MODE=false + DATABASE_URL and add
#    integration keys for the platforms you use.
# 3. Start: pnpm dev   (or: docker compose up)
# All sources flow into the same accounts + contacts tables, keyed by
# cross-platform IDs (sfdcAccountId, clayRecordId, …) for unified tracking.
